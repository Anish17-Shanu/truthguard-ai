# Local reference values for docker compose. Copy to .env and change every secret.
MONGODB_URI=mongodb://mongo:27017/truthguard
# Leave empty in development to use an ephemeral key. Production requires a Base64 key of 32+ bytes:
# openssl rand -base64 48
JWT_SECRET=
# Shared between backend and ai-service, at least 24 characters.
AI_INTERNAL_TOKEN=local-dev-internal-token-24chars
# Optional checksummed model bundle (see ai-service/training/README.md).
MODEL_ARTIFACT_URL=
MODEL_ARTIFACT_SHA256=
AI_SERVICE_BASE_URL=http://ai-service:8000
BACKEND_URL=http://backend:8080
SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=privacy@truthguard.ai
