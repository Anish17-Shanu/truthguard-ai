PORT=8080
MONGODB_URI=mongodb://localhost:27017/truthguard
# Base64-encoded HMAC key, at least 32 bytes after decoding. Generate with: openssl rand -base64 48
# Leave empty in development to use an ephemeral key (tokens do not survive a restart).
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=30
# Shared secret with the AI service. At least 24 characters; must match INTERNAL_TOKEN there.
AI_INTERNAL_TOKEN=local-dev-internal-token-24chars
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=120
MAX_ANALYSES_PER_MINUTE=30
MAX_ANALYSES_PER_DAY=200
# 0 keeps analyses forever; set e.g. 365 to purge older records.
ANALYSES_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=180
# Optional bootstrap admin. Use a unique password of 12+ characters in any real deployment.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=TruthGuard Admin
