APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=truthguard
MODEL_PATH=artifacts/model.onnx
TOKENIZER_PATH=artifacts/tokenizer.json
MANIFEST_PATH=artifacts/manifest.json
MODEL_VERSION=v1.0.0
# Optional: download a checksummed model.zip from a public https release URL at startup.
MODEL_ARTIFACT_URL=
MODEL_ARTIFACT_SHA256=
MODEL_ARTIFACT_MAX_MB=300
REQUIRE_ENGLISH=true
# Must match AI_INTERNAL_TOKEN on the backend. INTERNAL_TOKEN is also accepted.
AI_INTERNAL_TOKEN=
RETRAIN_ENABLED=false
ALLOW_HEURISTIC_FALLBACK=false
